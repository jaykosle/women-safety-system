'use client'
import { useAuth } from '@/context/AuthContext';
import React, { useState, useEffect } from 'react';
import Link from 'next/link';
import {
  Shield, Map, Navigation, Bell, BarChart2, AlertTriangle,
  HeartHandshake, ChevronRight, CheckCircle, Zap, Eye, Users,
  ArrowRight, Star, Lock, Globe, Activity
} from 'lucide-react';
import StateCrimeChart from '@/components/Landing Page Components/StateCrimeChart';
import CrimeTrendChart from '@/components/Landing Page Components/CrimeTrendChart';
import CrimePieChart from '@/components/Landing Page Components/CrimePieChart';

const features = [
  {
    icon: AlertTriangle,
    color: 'text-amber-500',
    bg: 'bg-amber-50',
    border: 'border-amber-100',
    title: 'AI Risk Prediction',
    desc: 'ML backend analyzes historical crime data to generate real-time risk scores (0-100) for any location.',
    badge: 'ML-Powered',
  },
  {
    icon: Map,
    color: 'text-violet-500',
    bg: 'bg-violet-50',
    border: 'border-violet-100',
    title: 'Safety Heatmaps',
    desc: 'Interactive maps with color-coded risk levels — visually assess neighborhood safety at a glance.',
    badge: 'Real-time',
  },
  {
    icon: Navigation,
    color: 'text-emerald-500',
    bg: 'bg-emerald-50',
    border: 'border-emerald-100',
    title: 'Safe Route Navigation',
    desc: 'Smart routing that minimizes combined cost of distance and predicted risk along your path.',
    badge: 'Smart Nav',
  },
  {
    icon: Bell,
    color: 'text-rose-500',
    bg: 'bg-rose-50',
    border: 'border-rose-100',
    title: 'SOS Emergency Alerts',
    desc: 'One-tap system that instantly broadcasts your live location to trusted contacts and authorities.',
    badge: 'Instant',
  },
  {
    icon: BarChart2,
    color: 'text-blue-500',
    bg: 'bg-blue-50',
    border: 'border-blue-100',
    title: 'Crime Analytics',
    desc: 'Powered by PostgreSQL for authorities to monitor crime trends and identify hotspots.',
    badge: 'Admin',
  },
  {
    icon: Users,
    color: 'text-pink-500',
    bg: 'bg-pink-50',
    border: 'border-pink-100',
    title: 'Trusted Contacts',
    desc: 'Manage and notify your safety network with automatic location sharing during emergencies.',
    badge: 'Network',
  },
];

const stats = [
  { value: '5M+', label: 'Crimes Recorded (2001–2021)', color: 'text-rose-400' },
  { value: '39.2%', label: 'Cases of Domestic Violence', color: 'text-violet-400' },
  { value: '23.8%', label: 'Cases of Assault on Women', color: 'text-amber-400' },
];

const trustItems = [
  { icon: Lock, text: 'End-to-end encrypted' },
  { icon: Globe, text: 'India-wide coverage' },
  { icon: Activity, text: 'Real-time ML scoring' },
  { icon: Zap, text: 'Sub-second SOS trigger' },
];

export default function LandingPage() {
  const { user, loading, logout } = useAuth();
  const [scrolled, setScrolled] = useState(false);

