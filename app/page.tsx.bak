          <div className="absolute bottom-0 left-0 w-[400px] h-[400px] bg-violet-50 rounded-full blur-3xl opacity-50 -translate-x-1/3 translate-y-1/3" />
        </div>

        <div className="max-w-7xl mx-auto">
