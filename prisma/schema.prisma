generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SosStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts     TrustedContact[]
  sosAlerts    SosAlert[]
  sessions     Session[]
  routeHistory RouteHistory[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model TrustedContact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trusted_contacts")
}

model SosAlert {
  id         String    @id @default(cuid())
  userId     String
  latitude   Float
  longitude  Float
  address    String?
  status     SosStatus @default(ACTIVE)
  message    String?
  notifiedAt DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])

  @@map("sos_alerts")
}

model CrimeRecord {
  id          String   @id @default(cuid())
  latitude    Float
  longitude   Float
  district    String
  state       String
  crimeType   String
  severity    String   @default("MEDIUM")
  year        Int
  timeOfDay   String   @default("UNKNOWN")
  caseCount   Int      @default(1)
  source      String   @default("synthetic")
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([latitude, longitude])
  @@index([district])
  @@index([crimeType])
  @@map("crime_records")
}

enum RiskLevel {
  SAFE
  MODERATE
  HIGH
  CRITICAL
}

model RiskZone {
  id             String    @id @default(cuid())
  latitude       Float
  longitude      Float
  gridResolution Float     @default(0.005)
  riskScore      Float
  riskLevel      RiskLevel
  crimeDensity   Float
  nightCrimeRate Float
  severityScore  Float
  crimeCount     Int
  lastUpdated    DateTime  @default(now())
  year           Int?

  @@unique([latitude, longitude, gridResolution])
  @@index([latitude, longitude])
  @@index([riskLevel])
  @@map("risk_zones")
}

model RouteHistory {
  id            String   @id @default(cuid())
  userId        String
  startLat      Float
  startLng      Float
  endLat        Float
  endLng        Float
  safeRoute     Json
  shortRoute    Json
  safeDistance  Float
  shortDistance Float
  avgRiskScore  Float
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@map("route_history")
}